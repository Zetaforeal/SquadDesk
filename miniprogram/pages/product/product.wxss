.page { padding-bottom: 140rpx; }
.gallery { width: 750rpx; height: 750rpx; }
.gallery-img { width: 750rpx; height: 750rpx; background: #f0f2f5; }

.info-card { background: #fff; padding: 24rpx 30rpx; }
.price-row { display: flex; align-items: center; justify-content: space-between; }
.price { font-size: 44rpx; color: #e6a23c; font-weight: 700; }
.sales { font-size: 24rpx; color: #909399; }
.name { font-size: 32rpx; color: #1f2d3d; margin-top: 10rpx; line-height: 1.5; }

.section { background: #fff; margin-top: 20rpx; padding: 24rpx 30rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #1f2d3d; margin-bottom: 20rpx; }
.form-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.label { width: 120rpx; font-size: 28rpx; color: #606266; }
.input { flex: 1; font-size: 28rpx; border-bottom: 1rpx solid #e4e7ed; padding: 10rpx 0; }
.desc { font-size: 26rpx; color: #606266; line-height: 1.7; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 30rpx; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}
.qty { display: flex; align-items: center; gap: 20rpx; }
.qty-label { font-size: 28rpx; color: #606266; }
.qty-ctrl { display: flex; align-items: center; gap: 16rpx; }
.qty-btn {
  width: 56rpx; height: 56rpx; border-radius: 8rpx; background: #f0f2f5;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: #1f2d3d;
}
.qty-num { font-size: 30rpx; min-width: 50rpx; text-align: center; }
.buy-btn {
  background: #2d6a9f; color: #fff; border-radius: 40rpx;
  padding: 0 56rpx; height: 64rpx; line-height: 64rpx; font-size: 28rpx; font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(45,106,159,0.25);
}
.buy-btn::after { border: none; }
