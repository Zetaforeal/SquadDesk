.page { min-height: 100vh; background: #f5f7fa; padding-bottom: 40rpx; }
.loading { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; color: #909399; font-size: 26rpx; }
.spinner {
  width: 60rpx; height: 60rpx; border: 6rpx solid #e4e7ed; border-top-color: #2d6a9f;
  border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

.banner-swiper { height: 320rpx; }
.banner-img { width: 100%; height: 320rpx; }

.section-title { padding: 30rpx 30rpx 10rpx; font-size: 34rpx; font-weight: 700; color: #1f2d3d; }
.activity-wrap { padding: 0 24rpx; }
.activity-img { width: 100%; height: 320rpx; border-radius: 12rpx; background: #f0f2f5; }

.product-grid { margin-top: 24rpx; padding: 0 24rpx; }
.grid-title { font-size: 32rpx; font-weight: 700; color: #1f2d3d; margin-bottom: 20rpx; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.grid-item { width: 342rpx; background: #fff; border-radius: 12rpx; overflow: hidden; margin-bottom: 20rpx; }
.grid-img { width: 342rpx; height: 342rpx; background: #f0f2f5; }
.grid-name { font-size: 28rpx; color: #1f2d3d; padding: 12rpx 16rpx 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.grid-price { font-size: 30rpx; color: #e6a23c; font-weight: 600; padding: 0 16rpx 16rpx; }

.cat-strip {
  display: flex; background: #fff; margin: 20rpx 24rpx; border-radius: 12rpx; padding: 20rpx 10rpx;
}
.cat-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.cat-icon { width: 88rpx; height: 88rpx; border-radius: 50%; background: #f0f2f5; }
.cat-name { font-size: 24rpx; color: #606266; }

.empty { text-align: center; color: #909399; padding-top: 200rpx; font-size: 28rpx; }

/* 租户到期全屏提示 */
.expired-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: #f5f7fa; z-index: 999;
  display: flex; align-items: center; justify-content: center;
}
.expired-box { text-align: center; padding: 40rpx; }
.expired-icon {
  width: 100rpx; height: 100rpx; margin: 0 auto 30rpx;
  border-radius: 50%; background: #e6a23c;
  position: relative;
}
.expired-icon::after {
  content: '!'; color: #fff; font-size: 60rpx; font-weight: 600;
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -52%);
}
.expired-title { font-size: 36rpx; font-weight: 600; color: #1f2d3d; margin-bottom: 16rpx; }
.expired-text { font-size: 28rpx; color: #606266; }
