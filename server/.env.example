# ===== 服务 =====
NODE_ENV=development
PORT=3000

# ===== MySQL 8.0（显式时区 +08:00）=====
DATABASE_URL="mysql://root:password@localhost:3306/super_saas?connection_limit=10&timezone=%2B08:00"

# ===== JWT =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 生产环境必须填写允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
TRUST_PROXY=false
# 仅本地联调可开启；生产环境强制禁止
ALLOW_DEV_LOGIN=false

# ===== 平台域名 =====
# 小程序 / Web 三端访问的后端根地址（不含尾部斜杠）
BASE_URL=http://localhost:3000

# ===== 北京时间校准（多源 fallback）=====
# 可用源：https://quan.suning.com/getSysTime.do | https://api.m.taobao.com/rest/api3.do?api=mtop.common.getTimestamp | 阿里云 NTP
TIME_SYNC_URLS=https://quan.suning.com/getSysTime.do,https://api.m.taobao.com/rest/api3.do?api=mtop.common.getTimestamp
TIME_SYNC_INTERVAL_HOURS=1

# ===== 超管初始账号（仅 seed 使用）=====
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# 默认不创建演示俱乐部；启用时两项密码都必须至少 12 位
SEED_DEMO_DATA=false
DEMO_ADMIN_PASSWORD=
DEMO_PLAYER_PASSWORD=

# ===== 上传目录 =====
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10
