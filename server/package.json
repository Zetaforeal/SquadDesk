{
  "name": "super-saas-server",
  "version": "1.0.0",
  "description": "多租户 SaaS 商城派单平台后端（Express + Prisma + MySQL 8.0）",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "worker": "node src/worker/index.js",
    "test": "node --test",
    "db:generate": "npx prisma generate",
    "db:validate": "prisma validate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:seed": "node scripts/seed.js",
    "sync-time": "node scripts/sync-time.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.1.0",
    "sharp": "^0.35.4",
    "xml2js": "^0.6.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.20.0"
  }
}
