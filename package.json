{
  "name": "super-saas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "server",
    "admin",
    "player",
    "super"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
